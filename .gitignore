# Env files (each .env.example is committed with local defaults)
.env*
!.env.example

# Node (frontend/)
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Python (backend/)
.venv/
__pycache__/
.ruff_cache/
.pytest_cache/

# Tracker output (backend/tracker): local state, reports and traces of each run
.tracker/
reports/*
!reports/.gitkeep
traces/*
!traces/.gitkeep

# Tools
.vercel
.neon
.DS_Store
*.log
*.pem
.idea/
.mcp.json
.claude/settings.json
