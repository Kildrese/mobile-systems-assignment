# Local development defaults. Copy to .env (scripts/start.sh does this for you).
# These credentials are for local use only — never reuse them elsewhere.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Must match the values above.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Better Auth. LOCAL-ONLY placeholder secret — generate a real one for any
# deployed environment (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
