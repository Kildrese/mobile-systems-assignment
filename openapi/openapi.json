{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobile Systems API",
    "description": "JSON API for accounts and users. Log in with `POST /api/auth/login`, then send the token as `Authorization: Bearer <token>`.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "The server is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created user. No token; log in next.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The email (EMAIL_TAKEN) or username (USERNAME_TAKEN) is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and get a bearer token",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A bearer token and the user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unknown email or username, or wrong password (indistinguishable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the logged-in user",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "The logged-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out (revoke the current token)",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "The token is revoked. Your other sessions stay valid."
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change your password",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Every session is revoked, including this one. Use the returned token from now on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangePasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The current password is wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/change-email": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change your email",
        "operationId": "changeEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeEmailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated user. Takes effect immediately, without verification; your token keeps working.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The current password is wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The email is already registered to another user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Read your own user",
        "operationId": "getUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The user's id (must be your own).",
              "format": "uuid",
              "title": "Id"
            },
            "description": "The user's id (must be your own)."
          }
        ],
        "responses": {
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The id is not your own. Same response whether it belongs to someone else, doesn't exist or isn't a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Update your own username or name",
        "operationId": "updateUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The user's id (must be your own).",
              "format": "uuid",
              "title": "Id"
            },
            "description": "The user's id (must be your own)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The id is not your own. Same response whether it belongs to someone else, doesn't exist or isn't a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The username is already taken by another user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete your own account",
        "operationId": "deleteUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The user's id (must be your own).",
              "format": "uuid",
              "title": "Id"
            },
            "description": "The user's id (must be your own)."
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted. All of your sessions are revoked."
          },
          "401": {
            "description": "Missing, malformed, unknown or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The id is not your own. Same response whether it belongs to someone else, doesn't exist or isn't a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeEmailBody": {
        "properties": {
          "newEmail": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "currentPassword": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "type": "object",
        "required": [
          "newEmail",
          "currentPassword"
        ],
        "title": "ChangeEmailBody"
      },
      "ChangePasswordBody": {
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          }
        },
        "type": "object",
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "title": "ChangePasswordBody"
      },
      "ChangePasswordResponse": {
        "properties": {
          "token": {
            "type": "string",
            "description": "The new bearer token. Every previous token is revoked."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "ChangePasswordResponse"
      },
      "Error": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "Error"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHORIZED",
          "INVALID_CREDENTIALS",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "EMAIL_TAKEN",
          "USERNAME_TAKEN",
          "INVALID_PASSWORD",
          "INTERNAL"
        ],
        "title": "ErrorCode"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "LoginBody": {
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "description": "Your email or your username."
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "description": "Same as `identifier`."
          },
          "username": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "description": "Same as `identifier`."
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginBody"
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "title": "LoginResponse"
      },
      "RegisterBody": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.]+$",
            "description": "3-30 letters, digits, `_` or `.`. Case-insensitive; stored lowercased."
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "maxLength": 100
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "RegisterBody"
      },
      "UpdateUserBody": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.]+$",
            "description": "3-30 letters, digits, `_` or `.`. Case-insensitive; stored lowercased."
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "maxLength": 100
          }
        },
        "type": "object",
        "title": "UpdateUserBody"
      },
      "User": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` if the user registered without an email."
          },
          "username": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "username",
          "firstName",
          "lastName",
          "createdAt",
          "updatedAt"
        ],
        "title": "User",
        "description": "A user. Never includes credentials."
      },
      "ValidationIssue": {
        "properties": {
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "code",
          "message"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "The `token` returned by `POST /api/auth/login`.",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Users"
    }
  ]
}
