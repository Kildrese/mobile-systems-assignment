{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(./scripts/db-migrate-neon.sh*)",
      "Bash(scripts/db-migrate-neon.sh*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel rollback*)",
      "Bash(vercel env add*)",
      "Bash(vercel env rm*)",
      "Bash(neon branches delete*)",
      "Bash(neon branches reset*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh workflow run*)",
      "mcp__Neon__run_sql",
      "mcp__Neon__run_sql_transaction",
      "mcp__Neon__complete_database_migration",
      "mcp__Neon__delete_branch",
      "mcp__Neon__reset_from_parent",
      "mcp__Neon__restore_snapshot",
      "mcp__Neon__set_default_branch",
      "mcp__plugin_vercel_vercel__create_deployment",
      "mcp__plugin_vercel_vercel__request_promote",
      "mcp__plugin_vercel_vercel__request_rollback",
      "mcp__plugin_vercel_vercel__create_project_env",
      "mcp__plugin_vercel_vercel__edit_project_env"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-private.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-py.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-checks.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
