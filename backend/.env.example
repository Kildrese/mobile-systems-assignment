# Local development defaults. Copy to backend/.env (scripts/start.sh does this
# for you). Must match the POSTGRES_* values in the root .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Comma-separated frontend origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Days of inactivity after which a session token expires.
SESSION_TTL_DAYS=7

# The daily tracker dispatch, production only (Vercel env). Leave empty locally:
# without CRON_SECRET the dispatch route answers 404.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=

# Tracker API keys (backend/tracker). Create your own; never commit them.
GROQ_API_KEY=
TAVILY_API_KEY=

# The verifier (services/verifier), called by the tracker's Verify stage. Optional
# locally: without them, Verify fails soft and every claim shows as unverified.
# For a local verifier: cd services/verifier && VERIFIER_TOKEN=... uv run fastapi dev main.py
VERIFIER_URL=
VERIFIER_TOKEN=

# The drafter (services/drafter), called by POST /api/drafts and `python -m app.draft_new`.
# Without DRAFTER_URL and DRAFTER_TOKEN, drafting answers 503.
# For a local drafter: cd services/drafter && DRAFTER_TOKEN=... ANTHROPIC_API_KEY=... uv run fastapi dev main.py --port 8002
DRAFTER_URL=
DRAFTER_TOKEN=
# Comma-separated usernames that may upload a profile and draft (they spend Anthropic
# tokens). Empty: no one.
DRAFTING_USERS=
